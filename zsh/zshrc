# ==============================================================================
# 1. ENVIRONMENT & PATH EXPORTS
# Set environment variables, $PATH modifications, and runtime configurations.
# ==============================================================================

# Homebrew path configuration
eval "$(/opt/homebrew/bin/brew shellenv)"

# Zoxide Setup
eval "$(/opt/homebrew/bin/zoxide init zsh)"

# Standard Editor
export EDITOR="hx"
export VISUAL="hx"

# ==============================================================================
# 2. SHELL OPTIONS (setopt)
# Configure shell behavior, directory navigation, and history rules.
# ==============================================================================


# ==============================================================================
# 3. COMPLETIONS
# Initialize Zsh completion system (compinit) and custom completion styles.
# ==============================================================================

zmodload zsh/complist

# Enable Completion System
autoload -Uz compinit && compinit

# Enable simple interactive arrow-key menu selection
zstyle ':completion:*' menu select

# Enable dotnet autocompletion
eval "$(dotnet completions script zsh)"

# ==============================================================================
# 4. TOOL INITIALIZATIONS & INTEGRATIONS
# Hook interactive CLIs, prompt engines (Starship), and tools into the shell.
# ==============================================================================
eval "$(starship init zsh)"


# ==============================================================================
# 5. ALIASES & CUSTOM FUNCTIONS
# Define command shortcuts, drop-in replacements, and shell functions.
# ==============================================================================

source ~/.zsh_aliases

