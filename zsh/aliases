# My Custom Aliases

# ---Navigation

alias dev='cd ~/dev'
alias htl='cd ~/Documents/education/htl'

# ---rm
alias rm='rm -i'

# ---git
alias g='git'
alias gst='git status'
alias ga='git add'
alias gc='git commit --message'
alias gp='git push'
alias gl='git pull'
alias glo='git log --oneline --decorate'
alias grs='git restore'
alias gsw='git switch'
alias gd='git diff'

# ------modern CLI replacements
alias cat='bat'

export EZA_ICONS_AUTO=1

# Listings
alias ls="eza"
alias ll="eza -lh"
alias la="eza -lah --git"

# Tree views
alias tree="eza -a --tree"
alias t2="eza -a --tree --level=2"
alias t3="eza -a --tree --level=3"
alias t4="eza -a --tree --level=4"
alias t5="eza -a --tree --level=5"
alias t6="eza -a --tree --level=6"
alias t7="eza -a --tree --level=7"
alias t8="eza -a --tree --level=8"
alias t9="eza -a --tree --level=9"
