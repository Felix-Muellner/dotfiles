#ls
alias ls='ls -a -G -p'
alias ll='ls -lh'
alias lla='ls -lAh'
alias llt='stat -f "Access: %Sa | Modify: %Sm | Change: %Sc | Birth: %SB | %N"'
alias tree='tree -a -C'
alias t2='tree -L 2'
alias t3='tree -L 3'
alias t4='tree -L 4'

#safety nets
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

#grep
alias grep='grep --color="auto"'

#path
alias pathlist='echo $PATH | tr ":" "\n"'

#navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'
alias dotfiles='cd ~/repos/dotfiles'
alias cs='cd ~/Documents/education/jku/ss26'

#bat
alias cat='bat'

#less
alias less='less -R'

#Quick reloads
alias src='source ~/.zshrc'
alias reload='exec zsh'

#git
alias gs='git status'
alias gl='git log --oneline --decorate --name-only '
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gd='git diff'

#system info
alias df='df -h'
alias du='du -h -c'
alias free='va_stat'

alias chmod-private='chmod 600'   # only me: read/write
alias chmod-shared='chmod 644'    # me: read/write, others: read
alias chmod-exec='chmod 755'      # typical for scripts: me full, others read/execute
alias chmod-lock='chmod 000'      # nobody can read/write/execute (lock a file)

# ---- Permission display ----
# Show files with permissions in a clear, detailed view
alias llp='ls -lO@'   # long listing + show permissions, flags, and extended attributes

#apps
alias chrome='open -a "Google Chrome"'
alias safari='open -a "Safari"'
alias settings='open -a "System Settings"'
alias intellij='open -a "Intellij IDEA"'
alias mail='open -a "Mail"'

#pyenv configuration and setup
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"

#latex
alias latex='cp ~/dev/templates/latex_template.tex ./'
