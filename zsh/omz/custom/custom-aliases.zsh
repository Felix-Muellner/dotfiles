# --- Navigation ---
alias cs='cd $HOME/Documents/education/jku/ss26'

alias dev='cd $HOME/dev'

alias work='cd ~/Documents/work/Controllerbox'

alias htl='cd ~/Documents/education/htl'

# -- tree --
# show all files including hidden, colorize output
alias tree='tree -a -C'

# tree levels
alias t2='tree -L 2'
alias t3='tree -L 3'
alias t4='tree -L 4'
alias t5='tree -L 5'
alias t6='tree -L 6'
alias t7='tree -L 7'
alias t8='tree -L 8'
alias t9='tree -L 9'

# -- rm --
alias rm='rm -i'

# --- LaTeX ---
# template copy
alias ltx='cp $HOME/dev/templates/latex_template.tex .'

# --- ls ---
alias ls='ls -pG'

# --- nvim ---
alias vim='nvim'
alias vimdiff='nvim -d'

# --- git ---
alias glf='git ls-files'
