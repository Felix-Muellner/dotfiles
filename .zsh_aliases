# ls family
alias chrome="open -a \"Google Chrome\""
alias ls='ls -p -G'
alias ll='ls -lh'
alias la='ls -A'
alias lla='ls -lAh'

# saftey nets
alias rm='rm -i'
alias cp='cp -i'
alias mv-'mv -i'

# grep quality of life
alias grep='grep --color=auto'

# navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'

# bat
alias cat='bat'

# less
alias less='less -R'

# Quick reloads
alias src='source ~/.zshrc'
alias reload='exec zsh'

# git
alias gs='git status'
alias gl='git log --oneline --graph --decorate'
alias ga='git add'
alias gc='git commit'
alias gp='git push'


# system info
alias df='df -h'     # human-readable disk space
alias du='du -h -c'  # human-readable folder sizes, with total
alias free='vm_stat' # macOS doesn’t have Linux `free`, but this is the rough equivalent